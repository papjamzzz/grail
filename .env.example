# Copy to .env and fill in real values. Never commit the real .env.

# Required for /api/ask, /api/import-labs, and the "Ask AILIV" panel.
ANTHROPIC_API_KEY=

# Optional — WHOOP OAuth sync (Settings panel: Connect/Sync/Disconnect).
# Register an app at https://developer-dashboard.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://127.0.0.1:5566/whoop/callback

# Optional — Postgres connection string for the 24h Circadian Ring history.
# Without it, /api/data/history degrades cleanly and /api/data (the latest
# snapshot) still works.
DATABASE_URL=

# Optional — shared secret to re-enable /debug-host and /debug-files.
# Leave unset to keep both routes disabled (404).
DEBUG_KEY=

# Optional — Flask port (defaults to 5566 if unset).
PORT=5566
